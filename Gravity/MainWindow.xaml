<Window x:Class="Gravity.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Gravity"
        Title="Gravity Simulator" Height="350" Width="525"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>
        <!--><Grid Background="Black"> </!-->
        <Grid MouseWheel="universeViewport3D_MouseWheel" MouseDown="universeViewport3d_MouseDown" MouseUp="universeViewport3d_MouseUp" MouseMove="universeViewport3d_MouseMove" Background="Black">
            <!--<Grid.Background>
                <ImageBrush ImageSource="/Resources/NGC869.jpg" />
            </Grid.Background>-->
            <Viewport3D Grid.Column="0" Name="universeViewport3D" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
        </Grid>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*" MaxHeight="50"/>
                <RowDefinition Height="1*" MaxHeight="20"/>
                <RowDefinition Height="1*" MaxHeight="20"/>
                <RowDefinition Height="4*" />
                <RowDefinition Height="1*" MaxHeight="50" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="LightGray">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Name="btnPlay" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5,5,5,5" FontSize="24" Click="btnPlay_Click">
                    <Image Source="/Resources/playPauseButton.jpg" />
                </Button>
                <Slider Grid.Column="1" Name="sldSpeed" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5,5,5,5"
                        Orientation="Horizontal" Minimum="0.1" Maximum="3.0" IsSnapToTickEnabled="True"
                        AutoToolTipPrecision="1" AutoToolTipPlacement="BottomRight" TickPlacement="BottomRight"
                        TickFrequency="0.1" Value="1" ValueChanged="sldSpeed_ValueChanged"/>
            </Grid>
            <Grid Grid.Row="1" Background="LightGray" Name="camOptions" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <RadioButton Grid.Column="0" Name="rdoCamFree" HorizontalAlignment="Center" Content="Free" Checked="rdoCamFree_Checked" />
                <RadioButton Grid.Column="1" Name="rdoCamFollow" HorizontalAlignment="Center" Content="Follow" Checked="rdoCamFollow_Checked"/>
                <RadioButton Grid.Column="2" Name="rdoCamRide" HorizontalAlignment="Center" Content="Ride" Checked="rdoCamRide_Checked" />
            </Grid>
            <Grid Grid.Row="2">
                <ComboBox Name="cbCameraCelestialBody" HorizontalAlignment="Stretch" IsEditable="True" IsReadOnly="True" SelectionChanged="cbCameraCelestialBody_SelectionChanged" />
            </Grid>
            <Grid Name="ListView" Grid.Row="3" VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="0"  VerticalAlignment="Stretch">
                    <ItemsControl Name="BodyList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <local:CBSelector x:Name="CBSelector"  Height="Auto" Width="Auto" MouseLeftButtonUp="CBSelector_MouseLeftButtonUp" MouseEnter="CBSelector_MouseEnter" MouseLeave="CBSelector_MouseLeave" />
                                    <Grid Name="RemoveBody" Tag="{Binding}" VerticalAlignment="Top" HorizontalAlignment="Right" Background="#00000000" Opacity="0.3" Width="20" Height="20" Margin="10,10,10,10" MouseLeftButtonUp="RemoveBody_MouseLeftButtonUp">
                                        <Image Source="Resources/remove.png" Stretch="Uniform" />
                                        <Grid.Triggers>
                                            <EventTrigger RoutedEvent="Grid.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RemoveBody" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="CBSelector" Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Grid.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="RemoveBody" Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.2" />
                                                        <DoubleAnimation Storyboard.TargetName="CBSelector" Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Grid.Triggers>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Grid Grid.Row="1">
                    <Button Name="btnAddBody" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="+" FontSize="14" Click="btnAddBody_Click" />
                </Grid>
                <Grid Grid.Row="2">
                    <Button Name="btnSS" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Add Solar System" FontSize="10" Click="btnSS_Click" />
                </Grid>
            </Grid>
            <local:CBView Grid.Row="3" x:Name="BodyView" Mode="Edit" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MouseDoubleClick="CBView_MouseDoubleClick" />
            <Grid Grid.Row="4" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="btnFrontView" Grid.Column="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="btnFrontView_Click">
                        <TextBlock Height="Auto" TextWrapping="Wrap" Text="Front View" />
                    </Button>
                    <Button Name="btnTopView" Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="btnTopView_Click">
                        <TextBlock Height="Auto" TextWrapping="Wrap" Text="Top View" />
                    </Button>
                    <Button Name="btnDiagView" Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="btnDiagView_Click">
                        <TextBlock Height="Auto" TextWrapping="Wrap" Text="Diagonal View" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
